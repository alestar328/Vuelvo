<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de Auto Backup para dispositivos anteriores a API 31
   (ver data_extraction_rules.xml para API 31+).

   No hay <include>: sin él se respalda todo por defecto, incluida vuelvo.db con las tarjetas
   del usuario. Sólo se excluyen los ficheros auxiliares del modo WAL de SQLite: copiarlos junto
   al .db puede restaurar una base de datos inconsistente, y sin ellos se restaura el .db ya
   consolidado. Ver https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="vuelvo.db-wal" />
    <exclude domain="database" path="vuelvo.db-shm" />
</full-backup-content>
