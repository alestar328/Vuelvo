<?xml version="1.0" encoding="utf-8"?><!--
   Logo de Vuelvo convertido del SVG original a VectorDrawable.

   Diferencias frente al SVG, porque VectorDrawable no admite todo lo que admite SVG:
   - El <text>V</text> del SVG NO se puede portar: VectorDrawable no soporta texto (ni fuentes).
     La "V" es aquí un trazo con extremos redondeados, igual que en ic_launcher_foreground.xml.
   - El <rect rx="232"> se convierte en un pathData con arcos: tampoco hay <rect>.
   - El <linearGradient> de <defs> pasa a <aapt:attr>; sus coordenadas van en unidades del
     viewport (0..1024), no en la fracción 0..1 que usa SVG.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Fondo redondeado con el degradado morado (equivale a <rect rx="232" fill="url(#vg320)">). -->
    <path android:pathData="M232,0 L792,0 A232,232 0 0 1 1024,232 L1024,792 A232,232 0 0 1 792,1024 L232,1024 A232,232 0 0 1 0,792 L0,232 A232,232 0 0 1 232,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="1024"
                android:endY="1024">
                <item
                    android:offset="0"
                    android:color="#FFA96BF8" />
                <item
                    android:offset="1"
                    android:color="#FF8B4DF3" />
            </gradient>
        </aapt:attr>
    </path>

